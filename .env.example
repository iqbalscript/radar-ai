# Public configuration consumed by the browser app.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Server-side API configuration. Keep secrets out of this file and out of Git.
RADAR_ENV=development
RADAR_LOG_LEVEL=INFO
RADAR_WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Optional local research-only DenseNet121 checkpoint (weights are never committed).
RADAR_CT_CHECKPOINT=data/model-artifacts/ct-binary-densenet121.pt
RADAR_CT_DEVICE=auto

# Optional Meta Model API smoke test. Keep the actual key only in your local environment.
MODEL_API_KEY=
RADAR_MODEL_ID=muse-spark-1.3

